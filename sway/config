# ----- #
# Setup #
# ----- #
exec export XDG_CURRENT_DESKTOP="sway"
exec export MOZ_ENABLE_WAYLAND=1
exec systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK I3SOCK XCURSOR_SIZE XCURSOR_THEME
exec hash dbus-update-activation-environment 2>/dev/null && \
        dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec mako
exec udiskie &
exec_always autotiling
input type:touchpad {
	events disabled_on_external_mouse
}

# --------------- #
# Variable Config #
# --------------- #
set $mod Mod4
set $smod Shift
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu wofi --location=center --show drun --allow-images true --insensitive true --mode overlay | xards swaymsg exec --
set $browser firefox
set $file_explorer nautilus

for_window {
	[class="^.*"] opacity 0.95
	[app_id="wofi"] floating enable
	[app_id="btop"] floating enable, resize set 1200 840
	[title="(?:Open|Save) (?:File|Folder|As)"] floating enable, resize set 1000 700
	[app_id="nmtui"] floating enable, resize set 1000 700
	[app_id="pavucontrol"] floating enable, resize set 600 420
	[app_id="blueman-manager"] floating enable, resize set 600 420
	[app_id="org.gnome.Nautilus"] floating enable, resize set 1000 700
	[app_id="org.gnome.FileRoller"] floating enable, resize set 600 420
	[app_id="org.gnome.Calendar"] floating enable, resize set 600 420
	[title=".*is sharing your screen."] border none
	[app_id="firefox"] inhibit_idle fullscreen
}

# --------- #
# Launchers #
# --------- #

bindsym {
	$mod+Return exec $term
	$mod+$smod+Return exec $file_explorer
	$mod+w exec $browser
	$mod+d exec $menu
	$mod+$smod+q kill
	$mod+p exec grimshot save active - | wl-copy
	$mod+$smod+p exec grimshot save area - | wl-copy
}

# ------------------- #
# Change Window Modes #
# ------------------- #

bindsym {
	$mod+f fullscreen
	$mod+$smod+f floating toggle
}
floating_modifier $mod normal

# -------------- #
# Audio Controls #
# -------------- #

bindsym --locked {
	XF86AudioPlay exec playerctl play-pause
	XF86AudioPause exec playerctl pause
	XF86AudioNext exec playerctl next
	XF86AudioPrev exec playerctl previous
	XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
	XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -3%
	XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
}

# --------------------- #
# Misc Control Shortcuts #
# --------------------- #

bindsym {
	XF86TouchpadToggle exec swaymsg input type:touchpad events toggle enabled disabled
	XF86MonBrightnessDown exec brightnessctl set 5%-
	XF86MonBrightnessUp exec brightnessctl set +5%
	$mod+$smod+c reload
}

# ------------------------------- #
# Swap Focus and Window Positions #
# ------------------------------- #

bindsym {
	$mod+$left focus left
	$mod+$down focus down
	$mod+$up focus up
	$mod+$right focus right
	$mod+$smod+$left move left
	$mod+$smod+$down move down
	$mod+$smod+$up move up
	$mod+$smod+$right move right
}

# ------------------------------------- #
# Swap Workspace Focus and Move Windows #
# ------------------------------------- #

set $num_workspaces 6
set $get_next_workspace_number_jq_script .[] | select(.focused) | if .num != null then (((if $forward then .num else .num - 2 end) % $num_workspaces + $num_workspaces) % $num_workspaces + 1) else 1 end
set $next_workspace_command swaymsg workspace number $(swaymsg --type=get_workspaces | jq '$get_next_workspace_number_jq_script')

bindsym  {
	$mod+Tab set $forward true, exec $next_workspace_command
	$mod+$smod+Tab set $forward false, exec $next_workspace_command
	$mod+1 workspace number 1
	$mod+2 workspace number 2
	$mod+3 workspace number 3
	$mod+4 workspace number 4
	$mod+5 workspace number 5
	$mod+6 workspace number 6
	$mod+7 workspace number 7
	$mod+8 workspace number 8
	$mod+9 workspace number 9
	$mod+0 workspace number 10
	$mod+$smod+1 move container to workspace number 1
	$mod+$smod+2 move container to workspace number 2
	$mod+$smod+3 move container to workspace number 3
	$mod+$smod+4 move container to workspace number 4
	$mod+$smod+5 move container to workspace number 5
	$mod+$smod+6 move container to workspace number 6
	$mod+$smod+7 move container to workspace number 7
	$mod+$smod+8 move container to workspace number 8
	$mod+$smod+9 move container to workspace number 9
	$mod+$smod+0 move container to workspace number 10
	$mod+Ctrl+h move workspace to output left
	$mod+Ctrl+j move workspace to output right
}

# ---------- #
# Appearance #
# ---------- #

font pango:IosevkaSlabTermMono 9
smart_gaps on
gaps inner 2
gaps outer 2
default_border pixel 1
default_floating_border pixel 2
output * bg /home/jbeale/.config/wallpapers/.wallpaper fill
set $bg #282828
set $focused #3c3836
set $fg #ebdbb2
set $red #cc241d
set $orange #fe8019

client.focused          $orange  $focused  $fg  $focused  $orange
client.focused_inactive $bg      $bg       $fg  $bg       $bg
client.unfocused        $bg      $bg       $fg  $bg       $bg
client.urgent           $red     $focused  $fg  $focused  $red

# --------------- #
# Activate Waybar #
# --------------- #

bar {
    swaybar_command waybar
}
