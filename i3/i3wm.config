# ------------ #
# Core Aliases #
# ------------ #
set $mod Mod4
set $smod Shift
set $left h
set $up j
set $down k
set $right l

# ---------------- #
# Core Keybindings #
# ---------------- #
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+$smod+Return exec i3-sensible-terminal -e ranger
bindsym $mod+q kill
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+Escape exec "/home/jbeale/scripts/power_menu"

set $screenshot Screenshot: Selected Region
bindsym $mod+$smod+p mode "$screenshot", exec "/home/jbeale/scripts/screenshot.sh"
mode "$screenshot" {
 bindsym Escape exec pkill import, mode "default"
}

# ---------------- #
# Basic Appearance #
# ---------------- #
font pango:HackNerdFontMono, FontAwesome 10
gaps inner 10
gaps outer 5
default_border pixel 4
default_floating_border pixel 4

# --------------------- #
# Appearance Autostarts #
# --------------------- #
exec_always --no-startup-id picom -b --config "/home/jbeale/.config/picom/picom.conf"
exec_always --no-startup-id "/home/jbeale/scripts/wallpaper.sh"
exec_always --no-startup-id xrdb "/home/jbeale/.config/X11/.Xresources"
exec --no-startup-id xrandr --output "VGA-1" --dpi 92 --rate 60

# -------------------------- #
# Suspend Control Autostarts #
# -------------------------- #
exec_always --no-startup-id xset +dpms dpms 0 600 600 
exec_always --no-startup-id xss-lock --transfer-sleep-lock -- /home/jbeale/scripts/lock.sh

# --------------- #
# Misc Autostarts #
# --------------- #
exec_always --no-startup-id dex --autostart --environment i3
exec udiskie &

# ------------------------------ #
# PACTL and i3blocks integration #
# ------------------------------ #
bindsym XF86AudioMute exec pactl set-sink-mute 0 toggle
bindsym XF86AudioMute --release exec pkill -RTMIN+1 i3blocks
bindsym XF86AudioLowerVolume exec pactl set-sink-volume 0 -5%
bindsym XF86AudioLowerVolume --release exec pkill -RTMIN+1 i3blocks
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume 0 +5%
bindsym XF86AudioRaiseVolume --release exec pkill -RTMIN+1 i3blocks


# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# change focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# move focused window
bindsym $mod+$smod+$left move left
bindsym $mod+$smod+$down move down
bindsym $mod+$smod+$up move up
bindsym $mod+$smod+$right move right

# split in horizontal orientation
bindsym $mod+b split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1:🖵 General"
set $ws2 "2:🌎 Browser"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2; exec pgrep firefox || /usr/bin/firefox-esr
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+$smod+1 move container to workspace number $ws1
bindsym $mod+$smod+2 move container to workspace number $ws2
bindsym $mod+$smod+3 move container to workspace number $ws3
bindsym $mod+$smod+4 move container to workspace number $ws4
bindsym $mod+$smod+5 move container to workspace number $ws5
bindsym $mod+$smod+6 move container to workspace number $ws6
bindsym $mod+$smod+7 move container to workspace number $ws7
bindsym $mod+$smod+8 move container to workspace number $ws8
bindsym $mod+$smod+9 move container to workspace number $ws9
bindsym $mod+$smod+0 move container to workspace number $ws10

# Pin firefox to appropriate workspace
for_window [class="firefox-esr"] move to workspace $ws2

# Make screencaps with feh float in the bottom right
for_window [class="feh"] floating enable, sticky enable, move position 1150 625

# reload the configuration file
bindsym $mod+$smod+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+$smod+r restart

# --------------- #
# Resize Bindings #
# --------------- #
bindsym $mod+r+$left resize shrink width 10 px or 10 ppt
bindsym $mod+r+$down resize grow height 10 px or 10 ppt
bindsym $mod+r+$up resize shrink height 10 px or 10 ppt
bindsym $mod+r+$right resize grow width 10 px or 10 ppt
 

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
 	font pango:HackNerdFontMono, FontAwesome 10
	position top
	strip_workspace_numbers yes
        status_command i3blocks -c /home/jbeale/.config/i3blocks/config
	colors {
                background #151828
                statusline #C7CBE1
                separator #20253C

#               <colorclass>       <brdr>  <bkgrd> <text>
                focused_workspace  #20253C #636FAB #A5ACCF
                active_workspace   #20253C #20253C #A5ACCF
                inactive_workspace #20253C #20253C #A5ACCF
                urgent_workspace   #20253C #FF9999 #A5ACCF
                binding_mode       #20253C #20253C #FFDD99
	}


}
