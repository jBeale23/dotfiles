# --------------------- #
# Global Configurations #
# --------------------- #
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = tab

# ---- #
# Bash #
# ---- #
[*.sh]
shell_variant = bash
switch_case_indent = true
space_redirects = true
binary_next = true
simplify = true

# --- #
# Lua #
# --- #
column_width = 160
line_endings = "Unix"
quote_style = "AutoPreferDouble"
call_parentheses = "None"
