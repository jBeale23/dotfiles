! URxvt Appearance
*.font: xft:Hack Nerd Font Mono:style=Regular:size=10
*.boldFont: xft:Hack Nerd Font Mono:style=Bold:size=10
*.italicFont: xft:Hack Nerd Font Mono:style=Italic:size=10
*.boldItalicfont:  xft:Hack Nerd Font Mono:style=Bold Italic:size=10
*.scrollBar: false
*.scrollBar_right: false

! URxvt Configuration
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.keysym.Control-Shift-C:    eval:selection_to_clipboard
URxvt.keysym.Control-Shift-V:      eval:paste_clipboard
URxvt.perl-ext-common: default,matcher
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.button: 1
