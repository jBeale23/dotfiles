# shellcheck shell=bash
# ------------------------------- #
# Here Be Aliases (And Functions) #
# ------------------------------- #

# ---------- #
# Ls aliases #
# ---------- #
if ls --color=auto &>/dev/null; then
	alias ls='ls --group-directories-first --time-style=+"%Y.%m.%d %H:%M" --color=auto'
else
	alias ls='ls --group-directories-first --time-style=+"%Y.%m.%d %H:%M"'
fi
alias ll='ls --almost-all -l --classify --human-readable'
alias la='ls --almost-all'
alias l='ls -C --classify'
alias lt='ls --human-readable --size -1 -S --classify'

# ------------ #
# Grep aliases #
# ------------ #
if printf "test" | grep --color=auto "test" &>/dev/null; then
	alias grep='grep --color=auto'
	alias fgrep='fgrep --color=auto'
	alias egrep='egrep --color=auto'
fi
alias hgrep='history | grep'

# ------------------ #
# Navigation aliases #
# ------------------ #
alias ..='cd ../'
alias ...='cd../../'
alias ....='cd../../../'
alias ~='cd ~'

function -() {
	cd - || return ${?}
}

# ----------- #
# Git Aliases #
# ----------- #
alias ga='git add'                      # [G]it [A]dd
alias gaa='git add --all'               # [G]it [A]dd [A]ll
alias gc='git commit'                   # [G]it [C]ommit
alias gca='git commit --all'            # [G]it [C]ommit [A]ll
alias gcam='git commit --all --message' # [G]it [C]ommit [A]ll [M]essage
alias gcm='git commit --message'        # [G]it [C]ommit [M]essage
alias gs='git status'                   # [G]it [S]tatus
alias gd='git diff ':!*lock''           # [G]it [D]iff
alias gdc='git diff --cached ':!*lock'' # [G]it [D]iff [C]ached
alias gdf='git diff'                    # [G]it [D]iff [F]ull
alias gdfc='git diff --cached '         # [G]it [D]iff [F]ull [C]ached
alias gco='git checkout'                # [G]it [C]heck[o]ut
alias gp='git push'                     # [G]it [P]ush
alias gl='git pull'                     # [G]it [P]ull

# ------------------------------- #
#      [G]it [M]ain [B]ranch      #
# Get the name of the main branch #
# ------------------------------- #
function gmb() {
	local main
	main=$(git symbolic-ref --short refs/remotes/origin/HEAD)
	status="${?}"
	main=${main#origin/}
	[[ -n ${main} ]] || return "${status}"
	printf "%s\n" "${main}"
}

# -------------------------------------------------------------------------- #
#                            [G]it [N]ew [B]ranch                            #
# Create a new branch, using $USER-Year-Month-Day if no template is provided #
# -------------------------------------------------------------------------- #
function gnb() {
	local branchname
	branchname="${1:-$(printf "%s-%(%Y-%m-%d)T" "${USER}" -1)}"
	git checkout -b "${branchname}"
}

# --------------------------------------------------------- #
#                   [G]it [B]ranch [D]iff                   #
# Compare the current branch to the HEAD of the main branch #
# --------------------------------------------------------- #
function gbd() {
	local main
	main=$(gmb) || return "${?}"
	git diff "${main}..HEAD" "${@}"
}

# ----------------------------------------- #
#         [G]it [C]heck[o]ut [M]ain         #
# Checkout the main branch and pull changes #
# ----------------------------------------- #
function gcom() {
	local main
	main=$(gmb) || return "${?}"
	git checkout "${main}" && git pull
}

# ------------------------------------------- #
#            [G]it [M]erge [M]ain             #
# Merge the main branch to the current branch #
# ------------------------------------------- #
function gmm() {
	local main
	main=$(gmb) || return "${?}"
	git merge "${main}"
}

# ------------------------------------- #
#   [G]it [R]epository [C]lone and CD   #
# Clone a git repository and CD into it #
# ------------------------------------- #
function grc() {
	git clone "${1}" || return "${?}"
	cd "$(basename "${1}" .git)" || return "${?}"
}

# ----------------- #
# Vim style aliases #
# ----------------- #
alias :q='exit 0'
alias :e='${VISUAL}'

# -------------------- #
# Drop-In Replacements #
# -------------------- #
alias vim='${VISUAL}'
alias vi='${VISUAL}'
if [[ -f "${REPOSITORY_DIR}/directory-explorer/directory-explorer.sh" ]]; then
	. "${REPOSITORY_DIR}/directory-explorer/directory-explorer.sh"
	alias cd='de'
fi

# ---------------- #
# Shell Cheatsheet #
# ---------------- #
function cs() {
	curl -s "https://cht.sh/${1}?qT&style=bw"
}

# ----------- #
# Easier Open #
# ----------- #
if xdg-open --version &>/dev/null; then
	alias open='xdg-open'
fi

# ----------- #
# Quick Edits #
# ----------- #
alias bashrc='${VISUAL} ~/.bashrc && source ~/.bashrc'
alias vimrc='${VISUAL} ~/.vimrc'

