# shellcheck shell=bash
# --------- #
# ENV Setup #
# --------- #

# ----------------- #
# XDG Configuration #
# ----------------- #
export XDG_CACHE_HOME="${HOME}/.cache"
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_STATE_HOME="${HOME}/.local/state"
export XDG_DOCUMENTS_DIR="${HOME}/Documents"

# -------------------- #
# Editor Configuration #
# -------------------- #
if nvim --version >/dev/null 2>&1; then
	export EDITOR="nvim"
elif vim --version >/dev/null 2>&1; then
	export EDITOR="vim"
elif vi --version >/dev/null 2>&1; then
	export EDITOR="vi"
elif nano --version >/dev/null 2>&1; then
	export EDITOR="nano"
else
	printf "WARNING: EDITOR could not be set.\n" >&2
fi
if [[ -n "${EDITOR}" ]]; then
	export VISUAL="${EDITOR}"
fi

# --------------------- #
# Manpage Configuration #
# --------------------- #
export LESS_TERMCAP_mb=$'\033[1;36m'
export LESS_TERMCAP_md=$'\033[1;36m'
export LESS_TERMCAP_me=$'\033[0m'
export LESS_TERMCAP_se=$'\033[0m'
export LESS_TERMCAP_so=$'\033[1;33m'
export LESS_TERMCAP_ue=$'\033[0m'
export LESS_TERMCAP_us=$'\033[4;1;32m'
export LESS_TERMCAP_mr=$'\033[7m'
export LESS_TERMCAP_mh=$'\033[2m'
export LESS_TERMCAP_ZN=$'\e[74m'
export LESS_TERMCAP_ZV=$'\e[75m'
export LESS_TERMCAP_ZO=$'\e[73m'
export LESS_TERMCAP_ZW=$'\e[75m'
export GROFF_NO_SGR=1
export PAGER='less'
export MANPAGER="${PAGER}"

# --------------------- #
# History Configuration #
# --------------------- #
export HISTCONTROL=ignoreboth # Ignore empty & duplicate content
export HISTSIZE=1000
export HISTFILESIZE=${HISTSIZE}
export HISTTIMEFORMAT="[%Y-%m-%d %T] " # Change date format to YYYY-mm-dd
export HISTIGNORE="&:ls:ll:la:l:lt:pwd:exit:\:e\:q:history:grep"

# ------------------- #
# Misc Configurations #
# ------------------- #
export LANG="en_US.UTF-8"
export TMPDIR="/tmp"

# ------------------------- #
# Safe Path Insert Function #
# ------------------------- #
function _path_insert() {
	case ":${PATH:=${1}}:" in
	*:"${1}":*) ;;
	*)
		export PATH="${1}:${PATH}"
		;;
	esac
}

# ----------------------------- #
# Python Environment Management #
# ----------------------------- #
if [[ -d "${HOME}/.src/miniforge3" ]]; then
	export MAMBA_ROOT_PREFIX="${HOME}/.src/miniforge3"
	if [[ -f "${MAMBA_ROOT_PREFIX}/bin/mamba" ]]; then
		export MAMBA_EXE="${HOME}/.src/miniforge3/bin/mamba"
		if __mamba_setup="$("${MAMBA_EXE}" shell hook --shell bash --root-prefix "${MAMBA_ROOT_PREFIX}" 2>/dev/null)"; then
			eval "${__mamba_setup}"
		else
			alias mamba='${MAMBA_EXE}'
		fi
		unset __mamba_setup
	fi
fi

if [[ -d "${HOME}/.src/pyenv" ]]; then
	export PYENV_ROOT="${HOME}/.src/pyenv"
	[[ -d "${PYENV_ROOT}/bin" ]] && _path_insert "${PYENV_ROOT}/bin" && eval "$(pyenv init - bash)"
fi

# --------------------------------- #
# User-Made Executables and Scripts #
# --------------------------------- #
declare -a user_executable_paths
user_executable_paths=("${HOME}/bin" "${HOME}/.bin" "${HOME}/.local/bin")
for path in "${user_executable_paths[@]}"; do
	[[ -d "${path}" ]] && _path_insert "${path}"
done

# --------------------------------------- #
# Export a Singleton Repository Directory #
# --------------------------------------- #
declare -a repository_directories
repository_directories=("${HOME}/repositories" "${XDG_DOCUMENTS_DIR}/repositories")
for path in "${repository_directories[@]}"; do
	[[ -d "${path}" ]] && export REPOSITORY_DIR="${path}" && break
done

unset -f _path_insert

# -------------------- #
# Noninteractive Guard #
# -------------------- #
case $- in
*i*) ;;
*) return ;;
esac

# ------ #
# Shopts #
# ------ #
shopt -s cdspell        # Allows cd to autocorrect typos
shopt -s checkwinsize   # Check the window size after each command and update LINES/COLUMNS
shopt -s cmdhist        # Save multiline commands in history
shopt -s dotglob        # Dotfiles are matched during filename expansion
shopt -s dirspell       # Allows typos when tab completing paths
shopt -s direxpand      # Expands variables into the path they represent
shopt -s expand_aliases # Aliases work as expected
shopt -s histappend     # Append rather than overwriting history
shopt -s hostcomplete   # Attempts hostname completion when @ is present in a string

# ----------- #
# Completions #
# ----------- #
if [[ -f /etc/bash_completion ]]; then
	. /etc/bash_completion 2>/dev/null
elif [[ -f ~/.bash_completion ]]; then
	. ~/.bash_completion 2>/dev/null
fi

# ----------------- #
# Readline bindings #
# ----------------- #
bind "set completion-ignore-case on"     # Case insensitive file completion
bind "set completion-map-case on"        # Hyphens and underscores are equivalent
bind "set show-all-if-ambiguous on"      # Display ambiguous matches on first tab press
bind "set mark-symlinked-directories on" # Autoadd trailing slash when completing directory symlinks
bind "set bell-style none"
bind "set show-mode-in-prompt"
bind "set editing-mode vi"
bind -m vi-command 'Control-l: clear-screen'
bind -m vi-insert 'Control-l: clear-screen'

# -------------------- #
# Prompt Configuration #
# -------------------- #
PROMPT_DIRTRIM=2

_blue_bold=$'\001\033[1;34m\002'
_green_bold=$'\001\033[1;32m\002'
_cyan_bold=$'\001\033[1;36m\002'
_red_bold=$'\001\033[1;31m\002'
_white_bold=$'\001\033[1;37m\002'
_yellow_bold=$'\001\033[1;33m\002'
_reset=$'\001\033[0m\002'

function returnCode() {
	status="${?}"
	local columns
	columns=$(($(tput cols) + 36))
	local status_string
	status_string=$(printf "%s(%sPrevious Return: %s%s%s)" "${_blue_bold}" "${_white_bold}" "${_cyan_bold}" "${status}" "${_blue_bold}")
	printf "%*s\r" "${columns}" "${status_string}"
}

function timestamp() {
	printf "%s[%s%(%H)T%s:%s%(%M)T%s:%s%(%S)T%s] " "${_blue_bold}" "${_white_bold}" -1 "${_blue_bold}" "${_white_bold}" -1 "${_blue_bold}" "${_white_bold}" -1 "${_blue_bold}"
}

function parseVenv() {
	if [[ -n "${venv}" ]]; then
		printf "%s(%s%s%s) " "${_blue_bold}" "${_cyan_bold}" "${venv}" "${_blue_bold}"
	fi
}

function parseMambaEnv() {
	if [[ -n "${CONDA_DEFAULT_ENV}" ]]; then
		printf "%s(%s%s%s) " "${_blue_bold}" "${_cyan_bold}" "${CONDA_DEFAULT_ENV}" "${_blue_bold}"
	fi
}

function parseUser() {
	local prompt_color
	if [[ "${EUID}" -eq 0 ]]; then
		prompt_color="${_red_bold}"
	else
		prompt_color="${_reset}"
	fi
	printf "%s%s" "${prompt_color}" "${USER}"
}

function parseHost() {
	if [[ -n "${SSH_CONNECTION}" ]]; then
		printf " %s[%sssh%s] %s%s" "${_blue_bold}" "${_cyan_bold}" "${_blue_bold}" "${_reset}" "${HOSTNAME%%.*}"
	fi
}

function parseGitBranch() {
	local branch
	if branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); then
		printf "%s(%s%s%s)%s " "${_blue_bold}" "${_reset}" "${branch}" "${_blue_bold}" "${_reset}"
	fi
}

function trapCommand() {
	if [[ -n "${AT_PROMPT}" ]]; then
		return
	fi
	printf "\033]0;%s\033\\" "${BASH_COMMAND}"
	"${REPOSITORY_DIR}/cmd-log/cmd-log" --database="${HOME}/.cmd-log.db" -- "${BASH_COMMAND}"
}
PROMPT_COMMAND='AT_PROMPT=1; printf "\033]0;%s\033\\" "${PWD/#${HOME}/~}"; unset AT_PROMPT'

bind "set vi-ins-mode-string ${_green_bold}INSERT${_reset}"
bind "set vi-cmd-mode-string ${_yellow_bold}COMMAND${_reset}"
PS1="\$(returnCode)"
PS1+="\$(timestamp)"
PS1+="\$(parseVenv)"
PS1+="\$(parseMambaEnv)"
PS1+="\$(parseUser)"
PS1+="\$(parseHost)"
PS1+="\n ${_white_bold}\w${_reset} "
PS1+="\$(parseGitBranch)"

export PS1
export PS4='+${BASH_SOURCE[0]##*/}($LINENO)/${FUNCNAME[0]}> '

# ------- #
# Aliases #
# ------- #
if [[ -e "${HOME}"/.bash_aliases ]]; then
	. "${HOME}/.bash_aliases" 2>/dev/null
fi

trap trapCommand DEBUG
# vim: set filetype=bash:
